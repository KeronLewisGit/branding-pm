/.phpunit.cache
/node_modules
# public/build is COMMITTED, deliberately.
#
# Deployment is `git pull` on shared hosting with no Node, so anything not
# in the repository does not reach the server. Ignoring the compiled assets
# would pull source that renders unstyled — and silently, since nothing
# errors when a manifest entry is missing, the page just arrives naked.
# The cost is churn: hashed filenames change on every asset edit.
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.nova
/.vscode
/.zed
/scripts/branding-pm.ico

/build

# Claude Code, per-machine
/.claude/settings.local.json

# Written by scripts/deploy.sh after a successful composer install, so the
# next deploy can tell whether vendor matches the lock. Per-server.
/storage/framework/.composer-lock-hash
