APP_NAME="Branding PM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Timestamps are stored in UTC (hard-coded); this only controls display.
APP_DISPLAY_TIMEZONE=America/Port_of_Spain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=branding_pm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

# Mail. Password resets and new-account credentials.
#
# Docker: `mailpit` accepts SMTP on 1025 and shows every message at
# http://localhost:8025 — nothing leaves the machine, which is what the pilot
# wants. Native PHP without Docker: leave MAIL_MAILER=log and read
# storage/logs/laravel.log.
#
# Go-live: prefer Admin -> Mail in the application. These values are the floor
# it falls back to, and the screen can be fixed without shell access at the
# moment somebody is locked out.
#
# MAIL_HOST must be a real relay. Leaving it unset does NOT disable mail — it
# defaults to 127.0.0.1 (config/mail.php), which hands every message to the
# machine's own mail server. On shared hosting that accepts mail for its own
# domains, relays nothing else, and refuses delivery with "554 Client host
# rejected". `php artisan mail:doctor` reports which relay is actually in use.
#
# MAIL_ENCRYPTION, not MAIL_SCHEME. This file named the wrong variable for
# some time; config/mail.php reads MAIL_ENCRYPTION and nothing anywhere reads
# MAIL_SCHEME, so following the old instruction set a value that did nothing.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@branding-pm.local"
MAIL_FROM_NAME="${APP_NAME}"

# Host port for the Mailpit inbox (Docker only).
MAIL_UI_PORT=8025

# HTTPS via the `caddy` reverse proxy (Docker, `tls` profile).
#
#     docker compose --profile tls up -d
#
# TLS_SITE_ADDRESS is the name or address browsers will use, and must match
# the certificate. While Caddy issues from its own local CA, every device has
# to trust that CA once — see docker/caddy/Caddyfile for how, and for the
# switch to a real certificate when IT provides a domain.
#
# Port 80 is often already in use on Windows; override HTTP_REDIRECT_PORT if
# `docker compose up` complains about the bind.
TLS_SITE_ADDRESS=192.168.0.14
HTTPS_PORT=8443
HTTP_REDIRECT_PORT=8080
# Must match HTTPS_PORT unless it is the standard 443, in which case
# leave this empty. The HTTP->HTTPS redirect points at the wrong port
# without it, because Caddy cannot see the port Docker published.
HTTPS_PUBLIC_SUFFIX=:8443

# Nightly database backup (Docker `backup` service).
#
# Dumps land in storage/backups on the HOST — deliberately not in a named
# volume, because `docker compose down -v` would destroy the backup along with
# the database it protects. Check them with `php artisan backup:status`.
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=14

# Off-site copies of the backups (Docker `backup-offsite` service).
#
# Dumps on the same machine as the database do not survive a failed disk or a
# stolen host. This copies them nightly to a network share and verifies each
# one by reading it back and comparing checksums.
#
# Behind a compose profile, because a wrong password or an unreachable file
# server makes the CIFS mount fail — and that must not be able to stop the
# application:
#
#     docker compose --profile offsite up -d
#
# BACKUP_OFFSITE_SHARE uses FORWARD slashes, not the backslashes of a UNC
# path: //fileserver/backups/branding-pm  (not \fileserverackups\…)
#
# The service account needs write access to the share and nothing else. The
# dumps contain every password and PIN hash in the plant, so do not put them
# on a share the whole company can read.
BACKUP_OFFSITE_SHARE=//fileserver/share/branding-pm
BACKUP_OFFSITE_USERNAME=
BACKUP_OFFSITE_PASSWORD=
# Domain-joined Windows file server? Put the domain here. A standalone NAS
# wants WORKGROUP, which is the default. Getting this wrong fails as a bare
# "permission denied" that reads like a wrong password.
BACKUP_OFFSITE_DOMAIN=WORKGROUP
BACKUP_OFFSITE_SMB_VERSION=3.0
BACKUP_OFFSITE_TIME=03:30
BACKUP_OFFSITE_RETENTION_DAYS=30

VITE_APP_NAME="${APP_NAME}"

# Checklist system overrides (all optional — defaults live in config/checklists.php)
# CHECKLISTS_GENERATION_TIME=05:00
# CHECKLISTS_DEFAULT_GRACE_PERIOD_HOURS=24
# CHECKLISTS_KIOSK_IDLE_SECONDS=120
# CHECKLISTS_PIN_MIN_LENGTH=4
# CHECKLISTS_PIN_MAX_LENGTH=6
# CHECKLISTS_PIN_MAX_ATTEMPTS=5
# CHECKLISTS_PIN_LOCKOUT_MINUTES=15
# CHECKLISTS_SIGNATURE_DISK=public
# CHECKLISTS_SIGNATURE_PATH=signatures

# --------------------------------------------------------------------------
# Docker (docker-compose.yml) — change these values when running in Docker:
# --------------------------------------------------------------------------
# APP_URL=http://localhost:8080
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=branding_pm
# DB_USERNAME=branding_pm
# DB_PASSWORD=secret

# --------------------------------------------------------------------------
# Shared hosting (Apache / LiteSpeed, e.g. Hostinger) - see docs/DEPLOYMENT.md 13
# --------------------------------------------------------------------------
# The application is unchanged: sessions and queue are database, cache is
# file, storage is local, and nothing needs Redis or a resident worker. Only
# these values differ, plus a cron line for the scheduler.
#
# The document root must be the public/ directory, and public/.htaccess must
# be readable (AllowOverride All). Without it the home page loads and every
# other route 404s, which reads like a routing bug in the application.
#
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://pm.yourdomain.com
# DB_HOST=localhost
# DB_DATABASE=uXXXXXXX_branding_pm
# DB_USERNAME=uXXXXXXX_pm
# DB_PASSWORD=
#
# Leave every BACKUP_OFFSITE_* value unset. That share is on the plant LAN
# and is unreachable from a datacentre; docs/DEPLOYMENT.md 13.6 covers what
# replaces it.

# --------------------------------------------------------------------------
# Security — set every one of these before the plant uses this for real
# --------------------------------------------------------------------------
# The first administrator's password. Leave BLANK and the seeder generates a
# random one and prints it once; there is no default password in the source.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Mark session and device cookies Secure (HTTPS-only).
#
# LEAVE THIS UNSET on production — it then defaults to TRUE automatically,
# because APP_ENV=production. Set it explicitly to false ONLY for a
# plain-http:// pilot, where a Secure cookie would stop anyone logging in at
# all. `php artisan security:check` reports it either way.
# SESSION_SECURE_COOKIE=true

# 'lax' lets a normal link into the app keep the session; 'strict' is tighter
# but breaks following a link from an email.
SESSION_SAME_SITE=lax

# Encrypt session payloads at rest in the database.
SESSION_ENCRYPT=false

# --------------------------------------------------------------------------
# Production
# --------------------------------------------------------------------------
# Set these two on the live host. APP_DEBUG=true there means any error page
# prints the stack trace, the failing query and this entire file — APP_KEY and
# the database password included.
#
# APP_ENV also switches on the safe defaults: Secure cookies, no lazy-loading
# warnings, cached config.
#
#     APP_ENV=production
#     APP_DEBUG=false
#     APP_URL=https://your-host
#
# Then verify, rather than hope:
#
#     php artisan security:check --strict
